{
    "name": "lettermint/lettermint-php",
    "description": "Official Lettermint PHP SDK: send email, manage the Team API and verify webhooks.",
    "type": "library",
    "keywords": [
        "Lettermint",
        "php",
        "lettermint-php",
        "email",
        "transactional email",
        "sdk",
        "webhooks"
    ],
    "homepage": "https://github.com/lettermint/lettermint-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Bjarn Bronsveld",
            "email": "bjarn@lettermint.co",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/extension-installer": "^1.3 || ^2.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Lettermint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lettermint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "generate": "@php scripts/generate.php",
        "generate:check": "@php scripts/generate.php --check"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
